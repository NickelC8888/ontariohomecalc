{
  "name": "User",
  "type": "object",
  "properties": {
    "first_name": {
      "type": "string",
      "description": "User's first name"
    },
    "last_name": {
      "type": "string",
      "description": "User's last name"
    },
    "address": {
      "type": "string",
      "description": "User's address"
    },
    "telephone": {
      "type": "string",
      "description": "User's telephone number"
    },
    "enable_property_lookup": {
      "type": "boolean",
      "description": "Enable property address lookup feature",
      "default": false
    },
    "role": {
      "type": "string",
      "enum": [
        "admin",
        "user"
      ],
      "default": "user",
      "description": "User role in the application"
    }
  },
  "required": [
    "first_name",
    "last_name"
  ]
}